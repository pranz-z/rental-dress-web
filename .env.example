# ─────────────────────────────────────────────────────────────
# Maison Rêve — environment
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local review: the bundled embedded Postgres (npm run db:start) listens on
# 127.0.0.1:54329 and answers at the default "postgres" database.
# Production: point this at your managed PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres"

# Session signing secret for the studio + account sign-in.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-32-byte-base64url-secret"

# Public origin of the storefront (used for absolute links in emails/receipts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Studio timezone — drives "today", the schedule and late-fee accrual.
STUDIO_TIMEZONE="America/New_York"

# Stripe test mode. Leave blank to run the studio's internal test gateway
# (identical checkout flow, no network calls, no charges).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
