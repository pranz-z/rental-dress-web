# ─────────────────────────────────────────────────────────────
# Maison Rêve — environment
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local review: the bundled embedded Postgres (npm run db:start) listens on
# 127.0.0.1:54329 and answers at the default "postgres" database.
# Production: point this at your managed PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres"

# Session signing secret for the studio + account sign-in.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-32-byte-base64url-secret"

# Public origin of the storefront (used for absolute links in emails/receipts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Studio timezone — drives "today", the schedule and late-fee accrual.
STUDIO_TIMEZONE="America/New_York"

# Stripe test mode. Leave blank to run the studio's internal test gateway
# (identical checkout flow, no network calls, no charges).
# Going live takes BOTH a live key (sk_live_…) and STRIPE_MODE="live": a live
# key with mode="test" refuses to run, and mode="live" with a test key refuses
# too, so a real charge cannot happen by accident.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MODE="test"

# Transactional email. Leave RESEND_API_KEY blank and every message is written
# to the local outbox at /studio/dev/outbox instead of being delivered.
RESEND_API_KEY=""
EMAIL_FROM="Maison Rêve <studio@maisonreve.com>"

# Local outbox folder (defaults to <project>/var/outbox).
OUTBOX_DIR=""

# Domain used for inquiry reply-to addresses (reply+INQ-####@<domain>).
# Inbound replies are posted to /api/email/inbound. Preferred: a Svix signing
# secret (`whsec_…`, as Resend issues) verified against every delivery.
# Fallback for plain forwarders: EMAIL_INBOUND_SECRET sent as the
# x-webhook-secret header. In production, unsigned requests are refused.
EMAIL_REPLY_DOMAIN="inbox.maisonreve.com"
EMAIL_INBOUND_SIGNING_SECRET=""
EMAIL_INBOUND_SECRET=""

# Server-error reporting. When set, src/instrumentation.ts forwards every
# uncaught server error here as JSON (Slack incoming webhook, monitor, …).
ERROR_WEBHOOK_URL=""

# Consumed once by `npm run db:seed:prod` against an empty database:
# the Owner's name, sign-in address and one-time password. Omit the password
# and one is generated and printed once; it dies at first sign-in either way.
OWNER_NAME=""
OWNER_EMAIL=""
OWNER_INITIAL_PASSWORD=""
